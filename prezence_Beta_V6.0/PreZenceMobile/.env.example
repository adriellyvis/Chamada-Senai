# IPv4 do computador que executa o Spring Boot (mesma rede Wi-Fi do celular).
# Não use "localhost" nem "127.0.0.1": no celular isso aponta para o próprio celular.
EXPO_PUBLIC_API_URL=http://192.168.X.X:8080

# Prefixo opcional das rotas da API (ex.: /api/v1). Deixe vazio se o login
# responde diretamente em /auth/login.
EXPO_PUBLIC_API_PREFIX=
